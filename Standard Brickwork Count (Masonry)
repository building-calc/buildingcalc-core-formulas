import test from "node:test";
import assert from "node:assert/strict";
import { calculateSlabVolume } from "../src/concrete/slab.js";

test("calculates rectangular slab volume", () => {
  assert.equal(calculateSlabVolume(5, 4, 0.15), 3);
});

test("returns zero for zero dimensions", () => {
  assert.equal(calculateSlabVolume(5, 4, 0), 0);
});

test("returns zero for negative dimensions", () => {
  assert.equal(calculateSlabVolume(-5, 4, 0.15), 0);
});

test("returns zero for non-finite inputs", () => {
  assert.equal(calculateSlabVolume(Infinity, 4, 0.15), 0);
});
